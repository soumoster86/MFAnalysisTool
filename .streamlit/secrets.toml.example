# Copy values into Streamlit Cloud → App settings → Secrets
# (Do NOT commit real secrets.toml — it is gitignored.)

# Required for production auth
SECRET_KEY = "replace-with-long-random-string"

# App
APP_ENV = "production"
DEBUG = "false"
LOG_LEVEL = "INFO"

# Optional LLM (AI Assistant)
OPENAI_API_KEY = "sk-..."
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-5.6-sol"
# Leave temperature unset for gpt-5 / o-series / *-sol models
# OPENAI_TEMPERATURE = "0.3"

# Database
# Streamlit Cloud local disk is EPHEMERAL — portfolios wipe on reboot unless you use Postgres.
# Free options: Neon, Supabase, Railway, ElephantSQL
# DATABASE_URL = "postgresql+psycopg://user:pass@host/db?sslmode=require"
#
# Ephemeral SQLite (OK for demos only):
DATABASE_URL = "sqlite:////tmp/mf_analysis.db"
DATA_CACHE_DIR = "/tmp/mf_cache"
