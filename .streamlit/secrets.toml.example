# Copy values into Streamlit Cloud → App settings → Secrets
# (Do NOT commit real secrets.toml — it is gitignored.)

# Required for production auth
SECRET_KEY = "replace-with-long-random-string"

# App
APP_ENV = "production"
DEBUG = "false"
LOG_LEVEL = "INFO"

# Optional LLM (AI Assistant)
OPENAI_API_KEY = "sk-..."
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-5.6-sol"
# Leave temperature unset for gpt-5 / o-series / *-sol models
# OPENAI_TEMPERATURE = "0.3"

# Database — Neon Postgres (persistent users + portfolio vault)
# console.neon.tech → Project → Connection string
# See docs/NEON.md
DATABASE_URL = "postgresql://neondb_owner:npg_xxxxx@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Cache only (ephemeral on Streamlit Cloud — OK)
DATA_CACHE_DIR = "/tmp/mf_cache"

# Ephemeral SQLite (demo only — DO NOT use if you need persistence):
# DATABASE_URL = "sqlite:////tmp/mf_analysis.db"
