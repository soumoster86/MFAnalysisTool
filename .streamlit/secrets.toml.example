# Copy values into Streamlit Cloud → App settings → Secrets
# (Do NOT commit real secrets.toml — it is gitignored.)

# Required for production auth
SECRET_KEY = "replace-with-long-random-string"

# App
APP_ENV = "production"
DEBUG = "false"
LOG_LEVEL = "INFO"

# Optional LLM (AI Assistant)
OPENAI_API_KEY = "sk-..."
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-5.6-sol"
# Leave temperature unset for gpt-5 / o-series / *-sol models
# OPENAI_TEMPERATURE = "0.3"

# Database — use Supabase for persistent users + portfolio vault
# Project Settings → Database → Connection string → URI (replace password)
# Example direct connection:
DATABASE_URL = "postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
#
# The app converts this to postgresql+psycopg:// and adds sslmode=require for Supabase.
# See docs/SUPABASE.md
#
# Ephemeral SQLite (demo only — data wiped on reboot):
# DATABASE_URL = "sqlite:////tmp/mf_analysis.db"
DATA_CACHE_DIR = "/tmp/mf_cache"
