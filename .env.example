# Application
APP_NAME=MF Analysis Tool
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
LOG_LEVEL=INFO

# Database (SQLite for Phase 1)
# Local SQLite (default)
DATABASE_URL=sqlite:///./data/mf_analysis.db
# Or Supabase Postgres (persistent / production):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Redis / Celery (stubs — optional for local run)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_ENABLED=false

# OpenAI-compatible LLM (Module 12 AI Assistant)
# Works with OpenAI, Azure OpenAI, Groq, Together, local Ollama (base_url), etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional. Leave unset for gpt-5.x / o-series / *-sol (they only allow default temperature).
# OPENAI_TEMPERATURE=0.3

# Data sources
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
# Historical NAV (mfapi.in primary, TigZig fallback)
MFAPI_BASE_URL=https://api.mfapi.in
TIGZIG_NAV_URL=https://api.tigzig.com/mf/v1/nav
# Holdings via Groww public web API (unofficial)
HOLDINGS_PROVIDER=groww
ALLOW_SYNTHETIC_NAV_FALLBACK=true
ALLOW_SAMPLE_HOLDINGS_FALLBACK=true
PERSIST_NAV_TO_DB=true
PERSIST_HOLDINGS_TO_DB=true
DATA_CACHE_DIR=./data/cache
NAV_CACHE_HOURS=12
HOLDINGS_CACHE_HOURS=24

# Auth (JWT — reserved for future multi-user)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Streamlit
STREAMLIT_SERVER_PORT=8501
API_HOST=0.0.0.0
API_PORT=8000
